{%- doc -%}
  Static premium mega menu panel rendered for one top-level menu item.

  @param {object} parent_link - Top-level navigation link for this panel.
  @param {string} list_id - Unique list ID for the menu list.
  @param {object} menu_block_settings - Parent header menu block settings.
{%- enddoc -%}

{% capture panel_blocks %}
  {% content_for 'blocks' %}
{% endcapture %}

{% render 'premium-mega-menu-panel',
  parent_link: parent_link,
  list_id: list_id,
  section: section,
  menu_block_settings: menu_block_settings,
  panel_block: block,
  children: panel_blocks
%}

{% schema %}
{
  "name": "t:names.premium_mega_menu_panel",
  "tag": null,
  "blocks": [
    {
      "type": "_mega-menu-promo"
    },
    {
      "type": "_mega-menu-collection"
    },
    {
      "type": "_mega-menu-product"
    },
    {
      "type": "_mega-menu-badge"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading"
    },
    {
      "type": "text",
      "id": "intro",
      "label": "t:settings.intro_text"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:settings.layout",
      "options": [
        {
          "value": "inherit",
          "label": "t:options.inherit"
        },
        {
          "value": "links_only",
          "label": "t:options.links_only"
        },
        {
          "value": "right_rail",
          "label": "t:options.right_content"
        },
        {
          "value": "left_rail",
          "label": "t:options.left_content"
        },
        {
          "value": "bottom_row",
          "label": "t:options.bottom_content"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "t:settings.desktop_columns",
      "options": [
        {
          "value": "inherit",
          "label": "t:options.inherit"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        },
        {
          "value": "5",
          "label": "5"
        },
        {
          "value": "6",
          "label": "6"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "checkbox",
      "id": "hide_content",
      "label": "t:settings.hide_promo_content",
      "default": false
    }
  ]
}
{% endschema %}

{%- doc -%}
  Static premium mega menu panel rendered for one top-level menu item.

  @param {object} parent_link - Top-level navigation link for this panel.
  @param {string} list_id - Unique list ID for the menu list.
  @param {object} menu_block_settings - Parent header menu block settings.
{%- enddoc -%}

{% capture panel_blocks %}
  {% content_for 'blocks' %}
{% endcapture %}

{% render 'premium-mega-menu-panel',
  parent_link: parent_link,
  list_id: list_id,
  section: section,
  menu_block_settings: menu_block_settings,
  panel_block: block,
  children: panel_blocks
%}

{% schema %}
{
  "name": "t:names.premium_mega_menu_panel",
  "tag": null,
  "blocks": [
    {
      "type": "_mega-menu-promo"
    },
    {
      "type": "_mega-menu-collection"
    },
    {
      "type": "_mega-menu-product"
    },
    {
      "type": "_mega-menu-badge"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading"
    },
    {
      "type": "text",
      "id": "intro",
      "label": "t:settings.intro_text"
    },
    {
      "type": "select",
      "id": "panel_width",
      "label": "t:settings.panel_width",
      "options": [
        {
          "value": "inherit",
          "label": "t:options.inherit"
        },
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:settings.layout",
      "options": [
        {
          "value": "inherit",
          "label": "t:options.inherit"
        },
        {
          "value": "links_only",
          "label": "t:options.links_only"
        },
        {
          "value": "right_rail",
          "label": "t:options.right_content"
        },
        {
          "value": "left_rail",
          "label": "t:options.left_content"
        },
        {
          "value": "bottom_row",
          "label": "t:options.bottom_content"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "t:settings.content_width",
      "min": 0,
      "max": 45,
      "step": 1,
      "unit": "%",
      "default": 0
    },
    {
      "type": "range",
      "id": "panel_padding",
      "label": "t:settings.panel_padding",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "t:settings.column_gap",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "t:settings.desktop_columns",
      "options": [
        {
          "value": "inherit",
          "label": "t:options.inherit"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        },
        {
          "value": "5",
          "label": "5"
        },
        {
          "value": "6",
          "label": "6"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "select",
      "id": "columns_tablet",
      "label": "t:settings.tablet_columns",
      "options": [
        {
          "value": "inherit",
          "label": "t:options.inherit"
        },
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:settings.image_ratio",
      "options": [
        {
          "value": "inherit",
          "label": "t:options.inherit"
        },
        {
          "value": "adapt",
          "label": "t:options.auto"
        },
        {
          "value": "4 / 5",
          "label": "t:options.portrait"
        },
        {
          "value": "1 / 1",
          "label": "t:options.square"
        },
        {
          "value": "16 / 9",
          "label": "t:options.landscape"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "t:settings.card_corner_radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "show_parent_link",
      "label": "t:settings.show_parent_link",
      "options": [
        {
          "value": "inherit",
          "label": "t:options.inherit"
        },
        {
          "value": "show",
          "label": "t:options.show"
        },
        {
          "value": "hide",
          "label": "t:options.hide"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "select",
      "id": "show_view_all",
      "label": "t:settings.show_view_all_link",
      "options": [
        {
          "value": "inherit",
          "label": "t:options.inherit"
        },
        {
          "value": "show",
          "label": "t:options.show"
        },
        {
          "value": "hide",
          "label": "t:options.hide"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "t:settings.animation",
      "options": [
        {
          "value": "inherit",
          "label": "t:options.inherit"
        },
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "fade",
          "label": "t:options.fade"
        },
        {
          "value": "slide",
          "label": "t:options.slide"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "checkbox",
      "id": "hide_content",
      "label": "t:settings.hide_promo_content",
      "default": false
    }
  ]
}
{% endschema %}

{% render 'premium-mega-menu-card',
  block: block,
  card_type: 'collection',
  resource: block.settings.collection,
  resource_type: 'collection',
  style: block.settings.card_style
%}

{% schema %}
{
  "name": "t:names.mega_menu_collection",
  "tag": null,
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "t:settings.collection"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "t:settings.card_style",
      "options": [
        {
          "value": "default",
          "label": "t:options.default"
        },
        {
          "value": "overlay",
          "label": "t:options.overlay"
        }
      ],
      "default": "default"
    }
  ]
}
{% endschema %}

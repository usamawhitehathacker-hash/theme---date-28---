{% render 'premium-mega-menu-card',
  block: block,
  card_type: 'product',
  resource: block.settings.product,
  resource_type: 'product',
  show_price: block.settings.show_price,
  show_vendor: block.settings.show_vendor,
  style: block.settings.card_style
%}

{% schema %}
{
  "name": "t:names.mega_menu_product",
  "tag": null,
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "t:settings.product"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "t:settings.show_price",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "t:settings.show_vendor",
      "default": false
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "t:settings.card_style",
      "options": [
        {
          "value": "default",
          "label": "t:options.default"
        },
        {
          "value": "compact",
          "label": "t:options.compact"
        }
      ],
      "default": "default"
    }
  ]
}
{% endschema %}

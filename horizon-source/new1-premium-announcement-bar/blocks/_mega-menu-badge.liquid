{% render 'premium-mega-menu-card',
  block: block,
  card_type: 'badge',
  heading: block.settings.text,
  link: block.settings.link,
  badge: block.settings.badge,
  style: 'chip'
%}

{% schema %}
{
  "name": "t:names.mega_menu_badge",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "t:settings.badge_text",
      "default": "New"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:settings.text",
      "default": "Best sellers"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    }
  ]
}
{% endschema %}

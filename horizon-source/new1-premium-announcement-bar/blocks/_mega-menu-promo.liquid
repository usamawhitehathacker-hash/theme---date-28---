{% render 'premium-mega-menu-card',
  block: block,
  card_type: 'promo',
  image: block.settings.image,
  heading: block.settings.heading,
  text: block.settings.text,
  link: block.settings.link,
  button_label: block.settings.button_label,
  badge: block.settings.badge,
  style: block.settings.card_style
%}

{% schema %}
{
  "name": "t:names.mega_menu_promo",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "t:settings.badge_text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "New arrivals"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:settings.text"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:settings.button_label",
      "default": "Shop now"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "t:settings.card_style",
      "options": [
        {
          "value": "default",
          "label": "t:options.default"
        },
        {
          "value": "overlay",
          "label": "t:options.overlay"
        },
        {
          "value": "compact",
          "label": "t:options.compact"
        }
      ],
      "default": "default"
    }
  ]
}
{% endschema %}
